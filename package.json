{
  "name": "my-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "predev": "npm run generate:seo",
    "prebuild": "npm run generate:seo",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "generate:seo": "node scripts/generate-static-seo.mjs",
    "test:seo": "node --test scripts/generate-static-seo.test.mjs",
    "test:security": "node --test scripts/security-headers.test.mjs",
    "test": "npm run test:seo && npm run test:security",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "geist": "^1.8.2",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
